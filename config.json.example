        "type": "click_position",
        "x": 1388,
        "y": 164,
        "offset_x": 0,
        "offset_y": 0,
        "move_duration_seconds": 0.15,
        "post_click_delay_seconds": 0.2,
        "label": "search_box"
      },
      {"type": "type_text", "text": "primal abyss"},
      {"type": "wait_seconds", "seconds": 3},
      {
        "type": "click_position",
        "x": 534,
        "y": 129,
        "offset_x": 0,
        "offset_y": 0,
        "move_duration_seconds": 0.15,
        "post_click_delay_seconds": 0.2,
        "label": "server_row"
      },
      {"type": "wait_seconds", "seconds": 1},
      {
        "type": "click_position",
        "x": 1395,
        "y": 757,
        "offset_x": 0,
        "offset_y": 0,
        "move_duration_seconds": 0.15,
        "post_click_delay_seconds": 0.5,
