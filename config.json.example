{
  "discord_token": "",
  "rcon_password": "",
  "restart_channel_id": 0,
  "restart_channel_name": "restarts",
  "restart_times": ["00:00", "06:00", "12:00", "18:00"],
  "scan_interval": 5,
  "starting_energy": 100,
  "reward_interval_seconds": 60,
  "max_reward_catchup_minutes": 60,
  "patreon_role_cache_ttl_seconds": 120,
  "health_poll_interval_seconds": 10,
  "crash_suspect_threshold": 2,
  "crash_confirm_threshold": 4,
  "executor_heartbeat_timeout_seconds": 60,
  "claim_retry_limit": 1,
  "claim_use_recovery_chain": true,
  "claim_precheck_commands": ["/health {steam_id} 100"],
  "claim_recovery_commands": [
    "/diet1 {steam_id} 100",
    "/diet2 {steam_id} 100",
    "/diet3 {steam_id} 100",
    "/health {steam_id} 100"
  ],
  "claim_commands": [
    "/growth {steam_id} 65",
    "/diet1 {steam_id} 100",
    "/diet2 {steam_id} 100",
    "/diet3 {steam_id} 100",
    "/hunger {steam_id} 100",
    "/health {steam_id} 100"
  ],
  "executor_loop_delay_seconds": 2,
  "executor_command_delays": {
    "/growth": 3,
    "/health": 1
  },
  "executor_enable_recovery_hook": false,
  "executor_recovery_macro_delay": 2,
  "executor_recovery_macro": [],
  "bot_presence": {
    "player_name": "YOUR_BOT_NAME",
    "steam_id": "",
    "missing_grace_seconds": 60,
    "confirm_rejoin_timeout_seconds": 120
  },
  "server_recovery": {
    "enabled": true,
    "max_rejoin_attempts": 10,
    "retry_backoff_seconds": [10, 20, 30, 60, 60, 120],
    "server_back_online_confirm_checks": 2
  },
  "bot_sustain": {
    "enabled": true,
    "interval_seconds": 90,
    "commands": ["/hunger 100", "/thirst 100", "/health 100"]
  },
  "rejoin_sequence": {
    "enabled": true,
    "mode": "image",
    "post_step_delay_seconds": 0.5,
    "steps": [
      {"type": "focus_window", "window_title_contains": "The Isle"},
      {"type": "wait_seconds", "seconds": 2},
      {"type": "click_image", "path": "assets/ui/play.png", "timeout_seconds": 15},
      {"type": "wait_for_image", "path": "assets/ui/session_filter.png", "timeout_seconds": 30},
      {"type": "click_image", "path": "assets/ui/session_filter.png", "timeout_seconds": 10},
      {"type": "click_image", "path": "assets/ui/unofficial.png", "timeout_seconds": 10},
      {"type": "click_image", "path": "assets/ui/search_box.png", "timeout_seconds": 10},
      {"type": "type_text", "text": "primal abyss"},
      {"type": "wait_seconds", "seconds": 3},
      {"type": "click_image", "path": "assets/ui/primal_server_row.png", "timeout_seconds": 15},
      {"type": "click_image", "path": "assets/ui/connect_button.png", "timeout_seconds": 10},
      {"type": "wait_seconds", "seconds": 25}
    ]
  },
  "rejoin_coordinates": {
    "play_button": {"x": 100, "y": 395},
    "session_filter": {"x": 1442, "y": 360},
    "unofficial_option": {"x": 1438, "y": 446},
    "search_box": {"x": 1378, "y": 163},
    "primal_server_row": {"x": 661, "y": 128},
    "connect_button": {"x": 1399, "y": 755},
    "focus_game": {"x": 960, "y": 540}
  },
  "ui_control": {
    "use_admin_panel": true,
    "player_name": "JJoness290",
    "open_panel_key": "insert",
    "stat_delay": 0.5,
    "loop_interval": 90,
    "player_row": {"x": 0, "y": 0},
    "input_box": {"x": 0, "y": 0},
    "buttons": {
      "hunger": {"x": 0, "y": 0},
      "thirst": {"x": 0, "y": 0},
      "health": {"x": 0, "y": 0}
    }
  }
}
