      },
      {"type": "wait_seconds", "seconds": 8},
      {
        "type": "click_position",
        "x": 1443,
        "y": 360,
        "offset_x": 0,
        "offset_y": 0,
        "move_duration_seconds": 0.15,
        "pre_click_delay_seconds": 0.05,
        "post_click_delay_seconds": 0.3,
        "label": "session_filter"
      },
      {"type": "wait_seconds", "seconds": 1},
      {
        "type": "click_position",
        "x": 1437,
        "y": 445,
        "offset_x": 0,
        "offset_y": 0,
        "move_duration_seconds": 0.15,
        "post_click_delay_seconds": 0.3,
        "label": "unofficial_option"
      },
      {"type": "wait_seconds", "seconds": 1},
